# Copy this file to .env and fill values locally. Never commit .env.

# Local Hugging Face inference
HF_TOKEN=
HF_TEXT_MODEL=Qwen/Qwen3-8B
HF_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
HF_IMAGE_STEPS=40
HF_MAX_NEW_TOKENS=4096
HF_IMAGE_CANDIDATES=2

# Authentication
ADMIN_EMAIL=admin@marketai.com
ADMIN_INITIAL_PASSWORD=
JWT_SECRET=

# Optional integrations
KIE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
TAVILY_API_KEY=
